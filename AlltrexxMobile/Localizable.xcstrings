    "Dit stopt de tracking en verwijdert je tracker, sleutel en lokaal opgeslagen posities van dit toestel. Dit kan niet ongedaan worden gemaakt.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit stopt de tracking en verwijdert je tracker, sleutel en lokaal opgeslagen posities van dit toestel. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stops tracking and deletes your tracker, key and locally stored positions from this device. This cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird das Tracking beendet und dein Tracker, Schlüssel und lokal gespeicherte Positionen werden von diesem Gerät gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela arrête le suivi et supprime votre traceur, votre clé et les positions enregistrées sur cet appareil. Action irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto detiene el seguimiento y borra tu rastreador, clave y posiciones guardadas en este dispositivo. No se puede deshacer."
          }
        }
      }
    },
