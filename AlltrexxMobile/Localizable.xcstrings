{
  "sourceLanguage": "nl",
  "version": "1.0",
  "strings": {
    "De server gaf een onverwacht antwoord. Probeer het later opnieuw.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server gaf een onverwacht antwoord. Probeer het later opnieuw."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server gave an unexpected response. Please try again later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat unerwartet geantwortet. Bitte versuche es später erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a renvoyé une réponse inattendue. Réessayez plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor dio una respuesta inesperada. Inténtalo de nuevo más tarde."
          }
        }
      }
    },
    "De sleutel werd geweigerd (onbekend of verlopen).": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutel werd geweigerd (onbekend of verlopen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key was rejected (unknown or expired)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel wurde abgelehnt (unbekannt oder abgelaufen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé a été refusée (inconnue ou expirée)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave fue rechazada (desconocida o caducada)."
          }
        }
      }
    },
    "Je hebt te snel achter elkaar sleutels aangemaakt. Wacht even en probeer het dan opnieuw.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt te snel achter elkaar sleutels aangemaakt. Wacht even en probeer het dan opnieuw."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You created keys too quickly in a row. Wait a moment and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast zu schnell hintereinander Schlüssel erstellt. Warte kurz und versuche es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez créé des clés trop rapidement. Patientez un instant puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has creado claves demasiado rápido. Espera un momento e inténtalo de nuevo."
          }
        }
      }
    },
    "De server meldde een fout (%@). Probeer het later opnieuw.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server meldde een fout (%@). Probeer het later opnieuw."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server reported an error (%@). Please try again later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat einen Fehler gemeldet (%@). Bitte versuche es später erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a signalé une erreur (%@). Réessayez plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor informó de un error (%@). Inténtalo de nuevo más tarde."
          }
        }
      }
    },
    "Instellingen": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
