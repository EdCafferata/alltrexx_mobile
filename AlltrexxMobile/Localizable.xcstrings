    "Deel je live positie met alltrexx.live, zodat anderen je op de kaart kunnen volgen.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel je live positie met alltrexx.live, zodat anderen je op de kaart kunnen volgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your live position with alltrexx.live so others can follow you on the map."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile deine Live-Position mit alltrexx.live, damit andere dir auf der Karte folgen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez votre position en direct avec alltrexx.live pour que d'autres vous suivent sur la carte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tu posición en directo con alltrexx.live para que otros te sigan en el mapa."
          }
        }
      }
    },
    "Je positie wordt (bijna) real-time doorgestuurd, ook als de app op de achtergrond draait.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je positie wordt (bijna) real-time doorgestuurd, ook als de app op de achtergrond draait."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your position is sent in (near) real time, even when the app runs in the background."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Position wird (nahezu) in Echtzeit übertragen, auch wenn die App im Hintergrund läuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position est transmise en temps (quasi) réel, même quand l'app tourne en arrière-plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu posición se envía en tiempo (casi) real, incluso con la app en segundo plano."
          }
        }
      }
    },
    "Alleen je positie en de naam die je kiest worden gedeeld. Je kunt alles op elk moment verwijderen.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen je positie en de naam die je kiest worden gedeeld. Je kunt alles op elk moment verwijderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your position and the name you choose are shared. You can delete everything at any time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur deine Position und der von dir gewählte Name werden geteilt. Du kannst alles jederzeit löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls votre position et le nom choisi sont partagés. Vous pouvez tout supprimer à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se comparten tu posición y el nombre que elijas. Puedes borrarlo todo en cualquier momento."
          }
        }
      }
    },
