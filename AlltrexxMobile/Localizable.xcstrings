    "Alltrexx Mobile is gratis. Met een kleine fooi steun je de verdere ontwikkeling — helemaal vrijblijvend.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltrexx Mobile is gratis. Met een kleine fooi steun je de verdere ontwikkeling — helemaal vrijblijvend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltrexx Mobile is free. A small tip supports further development — completely optional."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltrexx Mobile ist kostenlos. Mit einem kleinen Trinkgeld unterstützt du die Weiterentwicklung – ganz unverbindlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltrexx Mobile est gratuit. Un petit pourboire soutient son développement — sans aucune obligation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltrexx Mobile es gratis. Con una pequeña propina apoyas su desarrollo, sin ningún compromiso."
          }
        }
      }
    },
