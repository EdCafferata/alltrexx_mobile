    },
    "Optionele kaartlagen. Zonder sleutel worden deze lagen verborgen; de app werkt verder gewoon.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionele kaartlagen. Zonder sleutel worden deze lagen verborgen; de app werkt verder gewoon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional map layers. Without a key these layers are hidden; the app works fine otherwise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Kartenebenen. Ohne Schlüssel werden diese Ebenen ausgeblendet; die App funktioniert ansonsten normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calques de carte facultatifs. Sans clé, ces calques sont masqués ; l'app fonctionne normalement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capas de mapa opcionales. Sin clave estas capas se ocultan; la app funciona con normalidad."
          }
        }
      }
    },
