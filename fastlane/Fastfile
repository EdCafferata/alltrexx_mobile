default_platform(:ios)

API_KEY = app_store_connect_api_key(
  key_id:        "G389F99P3B",
  issuer_id:     "69a6de7f-a9c3-47e3-e053-5b8c7c11a4d1",
  key_filepath:  "#{Dir.home}/.appstoreconnect/private_keys/AuthKey_G389F99P3B.p8"
)

SCHEME       = "AlltrexxMobile"
PROJECT      = "AlltrexxMobile.xcodeproj"
BUNDLE_ID    = "info.cafferata.alltrexx"
SCREENSHOTS  = "AppStore/Screenshots"

platform :ios do

  # ─── TestFlight ────────────────────────────────────────────────────────────
  desc "Build en upload naar TestFlight"
  # Manual signing (dit account kan geen cloud-managed distribution via de API-key):
  # certificaat + profiel staan lokaal, profiel via de ASC-API aangemaakt.
  PROFILE   = "alltrexx AppStore 2026-11-06"
  SIGN_ID   = "iPhone Distribution: The IT Crowd (9J2S23WJH3)"
  TEAM_ID   = "9J2S23WJH3"

  lane :beta do
    build_app(
      project:           PROJECT,
      scheme:            SCHEME,
      configuration:     "Release",
      export_method:     "app-store",
      xcargs:            "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=\"#{SIGN_ID}\" PROVISIONING_PROFILE_SPECIFIER=\"#{PROFILE}\" DEVELOPMENT_TEAM=#{TEAM_ID} CURRENT_PROJECT_VERSION=#{Time.now.strftime('%Y%m%d%H%M')}",
      export_options: {
        signingStyle:         "manual",
        teamID:               TEAM_ID,
        provisioningProfiles: { BUNDLE_ID => PROFILE }
      }
    )
    upload_to_testflight(
      api_key: API_KEY,
      skip_waiting_for_build_processing: true
    )
  end

  # ─── macOS (Mac Catalyst) → TestFlight / App Store Connect ───────────────────
  # Automatic + cloud-managed signing via de Admin-key 5R3497VHF5 (zoals Riskonacci).
  # Zelfde bundle-ID en app-record (universeel), eigen Mac-binary.
  ADMIN_KEY_ID   = "5R3497VHF5"
  ADMIN_KEY_PATH = "#{Dir.home}/.appstoreconnect/private_keys/AuthKey_5R3497VHF5.p8"
  ISSUER_ID      = "69a6de7f-a9c3-47e3-e053-5b8c7c11a4d1"

  desc "Bouw Mac Catalyst-archive en upload naar App Store Connect (macOS)"
  lane :mac_beta do
    admin_key = app_store_connect_api_key(key_id: ADMIN_KEY_ID, issuer_id: ISSUER_ID, key_filepath: ADMIN_KEY_PATH)
    build_app(
      project:           PROJECT,
      scheme:            SCHEME,
      configuration:     "Release",
      catalyst_platform: "macos",
      export_method:     "app-store",
      xcargs: "CODE_SIGN_STYLE=Automatic CODE_SIGN_IDENTITY=\"Apple Development\" DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CURRENT_PROJECT_VERSION=#{Time.now.strftime('%Y%m%d%H%M')} " \
              "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{ADMIN_KEY_PATH} " \
              "-authenticationKeyID #{ADMIN_KEY_ID} " \
              "-authenticationKeyIssuerID #{ISSUER_ID}",
      export_options: { signingStyle: "automatic", teamID: TEAM_ID }
    )
    upload_to_testflight(api_key: admin_key, app_platform: "osx", skip_waiting_for_build_processing: true)
  end

  desc "macOS-listing: metadata + Mac-screenshots naar de macOS-versie (geen submit)"
  lane :mac_listing do
    admin_key = app_store_connect_api_key(key_id: ADMIN_KEY_ID, issuer_id: ISSUER_ID, key_filepath: ADMIN_KEY_PATH)
    upload_to_app_store(
      api_key:                           admin_key,
      app_identifier:                    BUNDLE_ID,
      platform:                          "osx",
      skip_binary_upload:                true,
      metadata_path:                     "fastlane/metadata-macos",
      screenshots_path:                  "AppStore/Screenshots-macOS",
      overwrite_screenshots:             true,
      submit_for_review:                 false,
      force:                             true,
      run_precheck_before_submit:        false,
      precheck_include_in_app_purchases: false
    )
  end

  # ─── Bestaande build indienen voor review (geen nieuwe binary) ─────────────
  desc "Dien de reeds geuploade build in voor App Store-review"
  lane :submit_now do
    upload_to_app_store(
      api_key:                     API_KEY,
      app_identifier:              BUNDLE_ID,
      build_number:                "202611082123",
      skip_binary_upload:          true,
      skip_screenshots:            true,
      skip_metadata:               true,
      submit_for_review:           true,
      automatic_release:           false,
      force:                       true,
      run_precheck_before_submit:  false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  # ─── Alleen listing vullen (metadata + screenshots, geen submit) ───────────
  desc "Metadata + screenshots uploaden naar de prepare-for-submission-versie"
  lane :listing do
    upload_to_app_store(
      api_key:                            API_KEY,
      app_identifier:                     BUNDLE_ID,
      skip_binary_upload:                 true,
      metadata_path:                      "fastlane/metadata",
      screenshots_path:                   SCREENSHOTS,
      overwrite_screenshots:              true,
      submit_for_review:                  false,
      force:                              true,
      run_precheck_before_submit:         false,
      precheck_include_in_app_purchases:  false
    )
  end

  # ─── App Store release ─────────────────────────────────────────────────────
  desc "Build, upload naar App Store en dien in ter beoordeling"
  lane :release do
    increment_build_number(xcodeproj: PROJECT)
    build_app(
      project:           PROJECT,
      scheme:            SCHEME,
      configuration:     "Release",
      export_method:     "app-store",
      export_options: {
        provisioningProfiles: {
          BUNDLE_ID => "match AppStore #{BUNDLE_ID}"
        }
      }
    )
    upload_to_app_store(
      api_key:                      API_KEY,
      submit_for_review:            true,
      automatic_release:            false,
      force:                        true,
      skip_screenshots:             false,
      screenshots_path:             SCREENSHOTS,
      metadata_path:                "fastlane/metadata",
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  # ─── Alleen screenshots uploaden ───────────────────────────────────────────
  desc "Upload screenshots naar App Store Connect"
  lane :screenshots do
    upload_to_app_store(
      api_key:                              API_KEY,
      app_identifier:                       BUNDLE_ID,
      skip_binary_upload:                   true,
      skip_metadata:                        true,
      force:                                true,
      edit_live:                            true,
      run_precheck_before_submit:           false,
      screenshots_path:                     SCREENSHOTS,
      ignore_language_directory_validation: true
    )
  end

  # ─── Alleen metadata uploaden (voor versie in voorbereiding) ──────────────
  desc "Upload beschrijving en release notes naar App Store Connect"
  lane :metadata do
    upload_to_app_store(
      api_key:                    API_KEY,
      app_identifier:             BUNDLE_ID,
      skip_binary_upload:         true,
      skip_screenshots:           true,
      force:                      true,
      run_precheck_before_submit: false,
      metadata_path:              "fastlane/metadata"
    )
  end

  # ─── Alleen promotional tekst updaten (werkt op live versie) ───────────────
  desc "Update promotional tekst op de live versie"
  lane :promo do
    upload_to_app_store(
      api_key:                    API_KEY,
      app_identifier:             BUNDLE_ID,
      skip_binary_upload:         true,
      skip_screenshots:           true,
      force:                      true,
      edit_live:                  true,
      run_precheck_before_submit: false,
      metadata_path:              "fastlane/metadata_promo"
    )
  end

end
